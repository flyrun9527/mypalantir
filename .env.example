# OpenAI-compatible LLM API settings
LLM_API_KEY=sk-placeholder
LLM_API_URL=http://localhost:8090/v1
LLM_MODEL=qwen3.5-plus

# Optional: set this for single-domain mode.
# Leave unset to mount all domains under /d/{domain}/.
# DOMAIN=domains/hv_access

# Remote MCP server used by the Agent and MCP management UI.
# All-domain MCP mode exposes one endpoint per domain:
#   http://127.0.0.1:8765/d/{domain}/mcp
OAG_MCP_BASE_URL=http://127.0.0.1:8765
OAG_MCP_TRANSPORT=streamable-http
